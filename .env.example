APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://seeyouthere:seeyouthere@localhost:5433/seeyouthere?sslmode=disable
VALKEY_URL=redis://localhost:6380/0
APP_ORIGINS=http://localhost:3100
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL=720h
# Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
TRUST_PROXY=false
# Zoho Mail SMTP. Use the host for your Zoho data centre (smtp.zoho.com, smtp.zoho.eu, smtp.zoho.in, ...)
# on port 587 (STARTTLS). SMTP_PASS should be a Zoho app-specific password, and MAIL_FROM must be the
# account address or one of its aliases.
SMTP_ADDR=smtp.zoho.com:587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="See You There <hello@seeyouthere.at>"
# Optional: send RSVP calendar-invite confirmations from a different Zoho
# mailbox than login/invite emails. Leave unset to reuse the main SMTP_*
# identity. RSVP_MAIL_FROM must be the RSVP_SMTP_USER account address or one
# of its aliases, or Zoho will reject it with a 553. RSVP_SMTP_USER/PASS/
# MAIL_FROM must all be set together; RSVP_SMTP_ADDR set alone, without the
# other three, is silently ignored.
# RSVP_SMTP_ADDR=smtp.zoho.com:587
# RSVP_SMTP_USER=
# RSVP_SMTP_PASS=
# RSVP_MAIL_FROM="See You There RSVPs <rsvp@seeyouthere.at>"
SITE_URL=http://localhost:3100
MEDIA_ROOT=./data/media
# openssl rand -base64 32 -- seals admin TOTP secrets at rest. Dev-only value below, change for real use.
TOTP_KEY=ZGV2LW9ubHktdG90cC1rZXktY2hhbmdlLW1lLTMyYmI=
ADMIN_ALERT_EMAIL=
MAIL_DAILY_INVITE_CAP=300
ADMIN_MFA_TTL=12h
# Media storage. Unset (all four R2_* empty) = local disk under MEDIA_ROOT/objects.
# To use Cloudflare R2 set ALL FOUR (a partial set makes the API refuse to start):
#   R2_ENDPOINT          https://<account id>.r2.cloudflarestorage.com (https, no path)
#   R2_BUCKET            private bucket name, lowercase letters, digits and hyphens
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY   API token scoped to that bucket (Object Read & Write)
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Photo quotas in decimal MB (1 MB = 1,000,000 bytes). Per user: 1..1000000. Total across all
# users: 100..10000000 and not below the per-user cap (keeps R2 inside its free tier).
# The per-user cap counts host uploads and approved guest photos; guest photos pending moderation
# count only toward the total (each event may hold at most 100 MB of them).
MEDIA_USER_QUOTA_MB=200
MEDIA_TOTAL_QUOTA_MB=9000
